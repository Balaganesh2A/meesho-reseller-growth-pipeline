{
  "description": "Representative questions for every supported intent plus invalid/ambiguous cases. Expectations name source rows by key (row_filter / row_select) and the columns whose verbatim values must appear in the answer; no production numbers are typed here.",
  "questions": [
    {"id": "monthly_ethnic_may", "question": "What was the revenue for Ethnic Wear in May?",
     "expected_intent": "MONTHLY_CATEGORY_REVENUE", "expected_status": "ok",
     "row_filter": {"month": "May", "category": "Ethnic Wear"}, "check_fields": ["month", "category", "revenue", "n_orders"]},
    {"id": "monthly_kids_april", "question": "What was Kids Wear revenue in April?",
     "expected_intent": "MONTHLY_CATEGORY_REVENUE", "expected_status": "ok",
     "row_filter": {"month": "April", "category": "Kids Wear"}, "check_fields": ["month", "category", "revenue", "n_orders"]},
    {"id": "monthly_all_june", "question": "What was the revenue in June?",
     "expected_intent": "MONTHLY_CATEGORY_REVENUE", "expected_status": "ok",
     "row_filter": {"month": "June"}, "check_fields": ["category", "revenue", "n_orders"]},
    {"id": "monthly_invalid_category", "question": "What was the revenue for Electronics in May?",
     "expected_intent": "MONTHLY_CATEGORY_REVENUE", "expected_status": "validation_error",
     "must_contain": ["Electronics", "not in the verified data"]},
    {"id": "monthly_invalid_month", "question": "What was the revenue for Ethnic Wear in January?",
     "expected_intent": "MONTHLY_CATEGORY_REVENUE", "expected_status": "validation_error",
     "must_contain": ["January", "not in the verified data"]},

    {"id": "region_highest", "question": "Which region had the highest revenue?",
     "expected_intent": "REGION_REVENUE", "expected_status": "ok",
     "row_select": "max:total_revenue", "check_fields": ["region", "total_revenue", "n_orders"]},
    {"id": "region_lowest", "question": "Which region had the lowest revenue?",
     "expected_intent": "REGION_REVENUE", "expected_status": "ok",
     "row_select": "min:total_revenue", "check_fields": ["region", "total_revenue", "n_orders"]},
    {"id": "region_named", "question": "What was the total revenue for the South region?",
     "expected_intent": "REGION_REVENUE", "expected_status": "ok",
     "row_filter": {"region": "South"}, "check_fields": ["region", "total_revenue", "n_orders"]},
    {"id": "region_all", "question": "Show revenue by region.",
     "expected_intent": "REGION_REVENUE", "expected_status": "ok",
     "row_filter": {}, "check_fields": ["region", "total_revenue", "n_orders"]},
    {"id": "region_invalid", "question": "What was the revenue in the Central region?",
     "expected_intent": "REGION_REVENUE", "expected_status": "validation_error",
     "must_contain": ["Central", "not in the verified data"]},

    {"id": "top5", "question": "Who are the top 5 resellers?",
     "expected_intent": "TOP_RESELLERS", "expected_status": "ok",
     "row_filter": {}, "check_fields": ["total_spend"]},
    {"id": "top3", "question": "Show me the top 3 resellers by spend.",
     "expected_intent": "TOP_RESELLERS", "expected_status": "ok",
     "row_filter": {"reseller_id": "RS019"}, "check_fields": ["total_spend"],
     "must_not_contain": ["ALIAS-06", "ALIAS-05"]},
    {"id": "top_unknown_reseller", "question": "Is RS030 one of the top resellers?",
     "expected_intent": "TOP_RESELLERS", "expected_status": "validation_error",
     "must_contain": ["RS030", "does not exist"]},

    {"id": "zero_never", "question": "Which reseller never placed an order?",
     "expected_intent": "ZERO_ORDER_RESELLERS", "expected_status": "ok",
     "row_filter": {}, "check_fields": ["region"]},
    {"id": "zero_no_orders", "question": "Which reseller had no orders?",
     "expected_intent": "ZERO_ORDER_RESELLERS", "expected_status": "ok",
     "row_filter": {}, "check_fields": ["region"]},

    {"id": "aov_june", "question": "What is the June delivered average order value?",
     "expected_intent": "JUNE_DELIVERED_AOV", "expected_status": "ok",
     "row_filter": {}, "check_fields": ["aov"]},
    {"id": "aov_wrong_month", "question": "What was the average order value in May?",
     "expected_intent": "JUNE_DELIVERED_AOV", "expected_status": "validation_error",
     "must_contain": ["Only the June Delivered AOV"]},

    {"id": "mom_ethnic_apr_may", "question": "How did Ethnic Wear change from April to May?",
     "expected_intent": "MOM_GROWTH", "expected_status": "ok",
     "row_filter": {"category": "Ethnic Wear", "previous_month": "April", "month": "May"},
     "check_fields": ["previous_month", "month", "category", "previous_revenue", "current_revenue", "mom_pct", "result"],
     "must_contain": ["increased"]},
    {"id": "mom_ethnic_may_jun", "question": "How did Ethnic Wear change from May to June?",
     "expected_intent": "MOM_GROWTH", "expected_status": "ok",
     "row_filter": {"category": "Ethnic Wear", "previous_month": "May", "month": "June"},
     "check_fields": ["previous_month", "month", "category", "previous_revenue", "current_revenue", "mom_pct", "result"],
     "must_contain": ["decreased"]},
    {"id": "mom_beauty_not_flagged", "question": "How did Beauty & Personal Care change from May to June?",
     "expected_intent": "MOM_GROWTH", "expected_status": "ok",
     "row_filter": {"category": "Beauty & Personal Care", "previous_month": "May", "month": "June"},
     "check_fields": ["previous_month", "month", "category", "previous_revenue", "current_revenue", "mom_pct", "result"],
     "must_contain": ["not_flagged"]},
    {"id": "mom_why", "question": "Why did Ethnic Wear revenue drop in June?",
     "expected_intent": "MOM_GROWTH", "expected_status": "ok",
     "row_filter": {"category": "Ethnic Wear", "previous_month": "May", "month": "June"},
     "check_fields": ["previous_revenue", "current_revenue", "mom_pct", "result"],
     "must_contain": ["FACT:", "HYPOTHESIS:", "not confirmed", "ACTION:"]},
    {"id": "mom_non_adjacent", "question": "How did Ethnic Wear change from April to June?",
     "expected_intent": "MOM_GROWTH", "expected_status": "validation_error",
     "must_contain": ["No verified month-over-month comparison"]},
    {"id": "mom_invalid_category", "question": "How did Electronics change from April to May?",
     "expected_intent": "MOM_GROWTH", "expected_status": "validation_error",
     "must_contain": ["Electronics", "not in the verified data"]},

    {"id": "unsupported_forecast", "question": "Tell me tomorrow's sales.",
     "expected_intent": "unsupported", "expected_status": "unsupported",
     "must_contain": ["Unsupported or ambiguous question"]},
    {"id": "unsupported_offtopic", "question": "What is the weather today?",
     "expected_intent": "unsupported", "expected_status": "unsupported",
     "must_contain": ["Unsupported or ambiguous question"]},
    {"id": "unsupported_vague", "question": "Tell me something interesting.",
     "expected_intent": "unsupported", "expected_status": "unsupported",
     "must_contain": ["Unsupported or ambiguous question"]}
  ]
}
